# =====================================================================
# Build PRODUKSI AI Vision Service (x86_64) — PyTorch CPU-only.
# Tujuan: menghindari tarikan paket CUDA (~2,5 GB) agar image ringan
# dan build tidak kehabisan RAM di VPS kecil (4 GB + swap).
# =====================================================================

FROM python:3.10-slim

RUN apt-get update && apt-get install -y \
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .

# Torch CPU-only dari index resmi PyTorch (tanpa dependensi CUDA).
# Jika versi di bawah tidak tersedia di index CPU, sesuaikan ke versi
# CPU terdekat yang kompatibel (torch & torchvision harus berpasangan).
RUN pip install --no-cache-dir --timeout=120 --retries=5 \
    --index-url https://download.pytorch.org/whl/cpu \
    torch==2.10.0 torchvision==0.25.0

RUN pip install --no-cache-dir --timeout=120 --retries=5 -r requirements.txt

COPY . .

EXPOSE 8001

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8001"]
