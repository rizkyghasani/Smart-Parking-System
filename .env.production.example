# =====================================================================
# CONTOH konfigurasi PRODUKSI (satu file untuk semua service).
# Salin menjadi .env.production lalu isi nilainya:
#   cp .env.production.example .env.production
# File .env.production TIDAK dikomit ke git.
#
# Semua perintah produksi memakai file ini:
#   docker compose --env-file .env.production -f docker-compose.prod.yml up -d --build
# =====================================================================

# ----- Domain & Caddy -----
# Ganti sesuai domain/subdomain yang A record-nya mengarah ke IP VPS.
DOMAIN=dijkstraparking.my.id

# ----- Database PostgreSQL -----
DB_DATABASE=parking_db
DB_USERNAME=admin
DB_PASSWORD=ubah-password-ini-menjadi-kuat

# ----- Laravel backend -----
APP_NAME="Smart Parking"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://dijkstraparking.my.id
APP_TIMEZONE=Asia/Jakarta
# Buat dengan: echo "base64:$(openssl rand -base64 32)"
APP_KEY=

# CORS & sesi
FRONTEND_URL=https://dijkstraparking.my.id
CORS_ALLOWED_ORIGINS=https://dijkstraparking.my.id
SANCTUM_STATEFUL_DOMAINS=dijkstraparking.my.id
SESSION_DOMAIN=.dijkstraparking.my.id

# Driver (database, tanpa Redis untuk cache/queue/session)
BROADCAST_CONNECTION=reverb
CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database

# Redis (opsional, tetap disediakan)
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# ----- Laravel Reverb (WebSocket) -----
# REVERB_HOST/PORT/SCHEME di sini adalah jalur INTERNAL backend->reverb.
# Browser terhubung lewat domain publik via Caddy (lihat VITE_* di bawah).
REVERB_APP_ID=139175
REVERB_APP_KEY=cxfh6ed96boglsqa9rsh
REVERB_APP_SECRET=ubah-secret-ini
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

# ----- Frontend (dipakai saat BUILD, di-inject ke bundle) -----
VITE_API_URL=https://dijkstraparking.my.id/api
VITE_AI_SERVICE_URL=https://dijkstraparking.my.id/ai
VITE_REVERB_APP_KEY=cxfh6ed96boglsqa9rsh
VITE_REVERB_HOST=dijkstraparking.my.id
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https
